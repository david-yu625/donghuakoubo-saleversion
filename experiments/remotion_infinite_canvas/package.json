{
  "name": "donghuakoubo-remotion-infinite-canvas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "python3 prepare_assets.py",
    "studio": "remotion studio src/index.ts",
    "render": "npm run render:frames && npm run encode",
    "render:frames": "remotion render src/index.ts InfiniteCanvas out/frames --sequence --image-format=jpeg --jpeg-quality=95 --overwrite",
    "encode": "python3 encode.py",
    "render:frame": "remotion still src/index.ts InfiniteCanvas out/preview.png --frame=430",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "@remotion/media": "4.0.526",
    "@remotion/transitions": "4.0.526",
    "remotion": "4.0.526"
  },
  "devDependencies": {
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
